{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "node",
        "outDir": "../../out/webview",
        "lib": ["es2023", "dom"],
        "jsx": "react",
        "typeRoots": [
            "../../node_modules/@types",
            "@types"
        ],
        "experimentalDecorators": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "incremental": true,
    },
    "include": [
        // "**/*.ts",
        // "**/*.tsx",
        // "**/*.jsx",
        "*/app/**/*.ts",
        "*/app/**/*.tsx",
        // "*/app/**/*.jsx",
        "./common/*.ts",
        "./common/*.tsx",
        // "common/*.jsx",
        "./create-component/pages/createComponent.tsx",
        "./create-component/pages/fromExistingGitRepo.tsx",
        "./create-component/pages/fromLocalCodebase.tsx",
        "./create-deployment/pages/builderImageListItem.tsx",
        "./create-deployment/pages/builderConfig.tsx",
        "../devfile-registry/devfileInfo.ts"
    ],
}
